# --- App ---
NEXT_PUBLIC_PROJECT_NAME="Sistema de Gerenciamento de Agendamentos SMUL"
PORT=3001
NEXT_PUBLIC_BASE_PATH=/agendamento

# --- Auth (NextAuth / staff) ---
AUTH_SECRET=
# AUTH_URL: use só se quiser forçar uma URL fixa. Deixe comentado ou use o IP/host
# real ao acessar por rede (ex.: http://10.10.5.1:3001). Com trustHost: true, o
# redirect pós-login usa o host da requisição.
# AUTH_URL=http://localhost:3001/agendamento

# JWT_SECRET assina/valida tokens de staff (access) e de munícipe (escopo MUNICIPE).
# RT_SECRET assina/valida o refresh token de staff.
JWT_SECRET=
RT_SECRET=

# --- Backend NestJS (ainda em uso durante a migração incremental) ---
# Usado pelos domínios que ainda não foram migrados para dentro do Next.js.
NEXT_PUBLIC_API_URL=http://localhost:3000/
# Override para chamadas server-side (ex.: rede interna do Docker). Cai no
# NEXT_PUBLIC_API_URL acima se não definido.
INTERNAL_API_URL=

# --- Banco de dados principal (Prisma) ---
DATABASE_URL=
SHADOW_DATABASE_URL=

# --- Banco legado SGU (somente leitura, best-effort) ---
SGU_DATABASE_URL=

# --- Banco BI (SQL Server, somente leitura) ---
# Tabelas dbo.ComuniqueSes e dbo.Despachos (processo / protocolo).
BI_DATABASE_URL=

# --- LDAP / Active Directory (login de staff) ---
ENVIRONMENT="local"
LDAP_SERVER="ldap://"
LDAP_DOMAIN=
LDAP_BASE=
USER_LDAP=
PASS_LDAP=

# --- E-mail (microserviço externo "mail-api") ---
MAIL_API_URL=http://localhost:3501
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=
MAIL_FROM=

# --- CORS (Socket.IO do custom server) ---
CORS_ORIGIN=http://localhost:3001

# --- Fluxo "Arthur Saboya" (pré-projetos) ---
# Mesmo UUID em ambas as chaves (uma para uso server-side, outra client-side).
DIVISAO_ID_PRE_PROJETOS=
NEXT_PUBLIC_DIVISAO_ID_PRE_PROJETOS=

# URL pública do próprio app, usada para montar links em e-mails (ex.: reset de senha).
FRONTEND_URL=http://localhost:3001/agendamento

# --- Microsoft Graph (reuniões Teams) ---
# Aplicação Azure com permissões de aplicativo (admin consent):
# Calendars.ReadWrite, OnlineMeetings.ReadWrite.All, OnlineMeetingArtifact.Read.All, Mail.Send
# Também é necessária Application Access Policy na caixa do marcador de reuniões
# (smuL_agendamento@prefeitura.sp.gov.br) para criar convites e avisar pontos focais.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
