generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id         String    @id @default(uuid())
  nome       String
  login      String    @unique
  email      String    @unique
  senha      String?   @db.VarChar(255)
  permissao  Permissao @default(PORTARIA)
  status     Boolean   @default(true)
  avatar     String?   @db.Text
  ultimoLogin  DateTime  @default(now())
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @default(now()) @updatedAt
  nomeSocial   String?
  divisaoId    String?

  agendamentos           Agendamento[]
  agendamentosCancelados Agendamento[]           @relation("AgendamentoCanceladoPor")
  solicitacoesPreProjetoArthurComoTecnicoArthur SolicitacaoPreProjetoArthurSaboya[] @relation("SolicitacaoArthurTecnico")
  divisao                Divisao?                @relation(fields: [divisaoId], references: [id], onDelete: SetNull)
  logImportacoesPlanilha LogImportacaoPlanilha[]
  logImportacoesOutlook  LogImportacaoOutlook[]
  mensagensPreProjetoArthurSaboya SolicitacaoPreProjetoArthurSaboyaMensagem[]
  configuracoesAtualizadas ConfiguracaoSistema[]
  regrasAgenda AgendaTecnico[]
  ausencias AusenciaTecnico[]
  eventosAgendamento EventoAgendamento[]

  @@map("usuarios")
}

model Agendamento {
  id                        String            @id @default(uuid())
  municipe                  String?
  cpf                       String?
  processo                  String?
  dataHora                  DateTime
  dataFim                   DateTime?
  importado                 Boolean           @default(false)
  importadoOutlook          Boolean           @default(false)
  tecnicoResponsavelPlanilha String?          @db.VarChar(255)
  resumo                    String?           @db.Text
  tipoAgendamentoId         String?
  motivoNaoAtendimentoId    String?
  coordenadoriaId           String?
  divisaoId                 String?
  tecnicoId                 String?
  tecnicoRF                 String?
  email                     String?
  telefone                  String?           @db.VarChar(32)
  relacaoInteressado        RelacaoInteressado?
  origemPortalProcesso      Boolean           @default(false)
  conferenciaCapStatus      ConferenciaCapStatus?
  unidadeDespachoBi         String?           @db.VarChar(255)
  encontradoNoBi            Boolean?
  biComuniqueSe             Boolean           @default(false)
  biIndeferido              Boolean           @default(false)
  confirmadoProcessoAusente Boolean           @default(false)
  observacaoCap             String?           @db.Text

  // Contexto preservado no momento da solicitação; independente do técnico do atendimento.
  modalidade                ModalidadeAgendamento?
  origemAgendamento         OrigemAgendamento?
  tipoRecurso               TipoRecursoAtendimento?
  ocorrenciaBiId            String?           @db.VarChar(64)
  protocoloOrigem           String?           @db.VarChar(255)
  sistemaOrigem             String?           @db.VarChar(255)
  situacaoRecurso           String?           @db.VarChar(255)
  unidadeOrigem             String?           @db.VarChar(255)
  responsavelOriginal       String?           @db.VarChar(255)
  responsavelOriginalRF     String?           @db.VarChar(64)
  encaminhadoReservaEm      DateTime?
  motivoEncaminhamentoReserva String?         @db.VarChar(255)
  snapshotBiEm              DateTime?
  duvidaAtendimento         String?           @db.Text
  localAtendimento          String?           @db.VarChar(255)
  sala                      String?           @db.VarChar(100)
  orientacaoAcesso          String?           @db.Text
  municipeContaId           String?
  status                    StatusAgendamento @default(SOLICITADO)

  teamsEventId           String?   @db.Text
  teamsJoinUrl           String?   @db.Text
  teamsMeetingId         String?   @db.Text
  teamsOrganizerEmail    String?   @db.VarChar(255)
  teamsUltimoErro        String?   @db.Text
  teamsSyncPendente      Boolean   @default(false)
  teamsSyncVersao        Int       @default(0)
  teamsSyncTentativas    Int       @default(0)
  teamsSyncEmProcessamentoAte DateTime?
  motivoCancelamento     String?   @db.Text
  canceladoEm            DateTime?
  canceladoPorId         String?
  presencaSincronizadaEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  tipoAgendamento      TipoAgendamento? @relation(fields: [tipoAgendamentoId], references: [id], onDelete: NoAction)
  motivoNaoAtendimento Motivo?          @relation(fields: [motivoNaoAtendimentoId], references: [id], onDelete: NoAction)
  coordenadoria        Coordenadoria?   @relation(fields: [coordenadoriaId], references: [id], onDelete: NoAction)
  divisao              Divisao?         @relation(fields: [divisaoId], references: [id], onDelete: SetNull)
  tecnico              Usuario?         @relation(fields: [tecnicoId], references: [id], onDelete: NoAction)
  canceladoPor         Usuario?         @relation("AgendamentoCanceladoPor", fields: [canceladoPorId], references: [id], onDelete: SetNull)
  presencasReuniao     PresencaReuniao[]
  eventos              EventoAgendamento[]
  municipeConta        MunicipeConta?   @relation(fields: [municipeContaId], references: [id], onDelete: SetNull)

  solicitacaoPreProjetoArthurSaboya SolicitacaoPreProjetoArthurSaboya?

  @@index([conferenciaCapStatus])
  @@index([municipeContaId])
  @@index([origemPortalProcesso])
  @@index([ocorrenciaBiId])
  @@index([teamsSyncPendente, teamsSyncEmProcessamentoAte])
  @@map("agendamentos")
}

model AgendaTecnico {
  id              String                @id @default(uuid())
  tecnicoId       String
  diaSemana       Int
  horaInicio      String                @db.VarChar(5)
  horaFim         String                @db.VarChar(5)
  duracaoMinutos  Int
  modalidade      ModalidadeAgendamento
  vigenciaInicio  DateTime              @db.Date
  vigenciaFim     DateTime?             @db.Date
  ativo           Boolean               @default(true)
  criadoEm        DateTime              @default(now())
  atualizadoEm    DateTime              @default(now()) @updatedAt
  tecnico         Usuario               @relation(fields: [tecnicoId], references: [id], onDelete: Restrict)

  @@index([tecnicoId, diaSemana, ativo])
  @@map("agendas_tecnicos")
}

model AusenciaTecnico {
  id              String   @id @default(uuid())
  tecnicoId       String
  tipo            String   @db.VarChar(80)
  dataHoraInicio  DateTime
  dataHoraFim     DateTime
  observacao      String?  @db.Text
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @default(now()) @updatedAt
  tecnico         Usuario  @relation(fields: [tecnicoId], references: [id], onDelete: Restrict)

  @@index([tecnicoId, dataHoraInicio, dataHoraFim])
  @@map("ausencias_tecnicos")
}

model EventoAgendamento {
  id             String      @id @default(uuid())
  agendamentoId  String
  atorId         String?
  tipo           String      @db.VarChar(80)
  dados          Json?
  criadoEm       DateTime    @default(now())
  agendamento    Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Restrict)
  ator           Usuario?    @relation(fields: [atorId], references: [id], onDelete: SetNull)

  @@index([agendamentoId, criadoEm])
  @@map("eventos_agendamento")
}

model TipoAgendamento {
  id           String   @id @default(uuid())
  texto        String   @unique
  status       Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  agendamentos Agendamento[]

  @@map("tipos_agendamento")
}

model Motivo {
  id           String   @id @default(uuid())
  texto        String   @unique
  status       Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  agendamentos Agendamento[]

  @@map("motivos")
}

model Coordenadoria {
  id           String   @id @default(uuid())
  sigla        String   @unique
  nome         String?
  email        String?  @db.VarChar(255)
  status       Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  agendamentos                       Agendamento[]
  divisoes                           Divisao[]
  solicitacoesPreProjetoArthurSaboya SolicitacaoPreProjetoArthurSaboya[]

  @@map("coordenadorias")
}

model Divisao {
  id              String   @id @default(uuid())
  sigla           String   @unique
  nome            String?
  status          Boolean  @default(true)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @default(now()) @updatedAt
  coordenadoriaId String?

  coordenadoria Coordenadoria? @relation(fields: [coordenadoriaId], references: [id], onDelete: SetNull)
  usuarios      Usuario[]
  agendamentos  Agendamento[]
  solicitacoesPreProjetoArthurSaboya SolicitacaoPreProjetoArthurSaboya[]

  @@map("divisoes")
}

/// Solicitações públicas de dúvidas / pré-projetos (formulário Arthur Saboya).
model SolicitacaoPreProjetoArthurSaboya {
  id              String   @id @default(uuid())
  protocolo       String   @unique
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @default(now()) @updatedAt

  nome            String
  email           String

  formacaoValor   String
  formacaoOutro   String?
  formacaoTexto   String   @db.VarChar(255)

  naturezaValor   String
  naturezaOutro   String?
  naturezaTexto   String   @db.VarChar(500)

  duvida          String   @db.Text

  status          StatusSolicitacaoPreProjeto @default(SOLICITADO)

  avaliacaoNota       Int?
  avaliacaoComentario String?  @db.Text
  avaliacaoEm         DateTime?
  dataAgendamento     DateTime?

  coordenadoriaId String?
  divisaoId       String?

  municipeContaId String?
  municipeConta   MunicipeConta? @relation(fields: [municipeContaId], references: [id], onDelete: SetNull)

  agendamentoId String? @unique
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)

  tecnicoArthurId String?
  tecnicoArthur   Usuario? @relation("SolicitacaoArthurTecnico", fields: [tecnicoArthurId], references: [id], onDelete: SetNull)

  coordenadoria Coordenadoria? @relation(fields: [coordenadoriaId], references: [id], onDelete: SetNull)
  divisao       Divisao?       @relation(fields: [divisaoId], references: [id], onDelete: SetNull)

  mensagens SolicitacaoPreProjetoArthurSaboyaMensagem[]

  @@map("solicitacoes_pre_projeto_arthur_saboya")
}

/// Mensagens do “chamado” (estilo GLPI): munícipe, ponto focal ou sistema.
model SolicitacaoPreProjetoArthurSaboyaMensagem {
  id              String                         @id @default(uuid())
  solicitacaoId   String
  autor           AutorMensagemPreProjetoArthurSaboya
  corpo           String                         @db.Text
  criadoEm        DateTime                       @default(now())

  usuarioId       String?
  usuario         Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  municipeContaId String?
  municipeConta   MunicipeConta? @relation(fields: [municipeContaId], references: [id], onDelete: SetNull)

  solicitacao SolicitacaoPreProjetoArthurSaboya @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  @@index([solicitacaoId])
  @@map("solicitacoes_pre_projeto_arthur_saboya_mensagens")
}

enum AutorMensagemPreProjetoArthurSaboya {
  MUNICIPE
  PONTO_FOCAL
  SISTEMA
}

enum Permissao {
  DEV
  ADM
  TEC
  ARTHUR_SABOYA
  ADM_ARTHUR_SABOYA
  USR
  PONTO_FOCAL
  COORDENADOR
  PORTARIA
  DIRETOR
}

enum StatusAgendamento {
  SOLICITADO
  AGENDADO
  CANCELADO
  CONCLUIDO
  ATENDIDO
  NAO_REALIZADO
}

enum ModalidadeAgendamento {
  PRESENCIAL
  ONLINE
}

enum OrigemAgendamento {
  RECURSO
  ARTHUR_SABOYA
}

enum TipoRecursoAtendimento {
  DESPACHO
  COMUNIQUE_SE
}

enum RelacaoInteressado {
  AUTOR_PROJETO
  AUTORIZADO
  PROPRIETARIO
  RESPONSAVEL_TECNICO
  TERCEIROS
}

enum ConferenciaCapStatus {
  AGUARDANDO
  ENCAMINHADO
  NAO_ENCONTRADO
}

enum StatusSolicitacaoPreProjeto {
  SOLICITADO
  RESPONDIDO //SOLUCIONADO
  AGUARDANDO_DATA
  AGENDAMENTO_CRIADO
}

model LogImportacaoPlanilha {
  id        String   @id @default(uuid())
  dataHora  DateTime @default(now())
  total     Int      @default(0)
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("log_importacao_planilha")
}

model LogImportacaoOutlook {
  id        String   @id @default(uuid())
  dataHora  DateTime @default(now())
  total     Int      @default(0)
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("log_importacao_outlook")
}

/// E-mail da caixa que cria as reuniões no Microsoft Teams (Graph).
model ConfiguracaoSistema {
  chave           String   @id
  valor           String   @db.Text
  atualizadoEm    DateTime @default(now()) @updatedAt
  atualizadoPorId String?
  atualizadoPor   Usuario? @relation(fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("configuracoes_sistema")
}

/// Participantes da reunião Teams (relatório de presença do Graph).
model PresencaReuniao {
  id               String    @id @default(uuid())
  agendamentoId    String
  displayName      String?   @db.VarChar(255)
  email            String?   @db.VarChar(255)
  role             String?   @db.VarChar(64)
  durationSeconds  Int?
  joinDateTime     DateTime?
  leaveDateTime    DateTime?

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([agendamentoId])
  @@map("presencas_reuniao")
}

model MunicipeConta {
  id                 String                       @id @default(uuid())
  nome               String
  email              String                       @unique
  senhaHash          String                       @map("senha_hash")
  status             Boolean                      @default(true)
  ultimoLogin        DateTime?                    @map("ultimo_login")
  criadoEm           DateTime                     @default(now()) @map("criado_em")
  atualizadoEm       DateTime                     @default(now()) @updatedAt @map("atualizado_em")
  tokensRedefinicao  MunicipeTokenRedefinicaoSenha[]

  solicitacoesPreProjetoArthurSaboya SolicitacaoPreProjetoArthurSaboya[]
  mensagensPreProjetoArthurSaboya    SolicitacaoPreProjetoArthurSaboyaMensagem[]
  agendamentos                       Agendamento[]

  @@map("municipes_contas")
}

model MunicipeTokenRedefinicaoSenha {
  id              String         @id @default(uuid())
  contaId         String         @map("conta_id")
  tokenHash       String         @map("token_hash")
  expiraEm        DateTime       @map("expira_em")
  utilizadoEm     DateTime?      @map("utilizado_em")
  criadoEm        DateTime       @default(now()) @map("criado_em")
  conta           MunicipeConta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId, tokenHash])
  @@map("municipes_tokens_redefinicao_senha")
}
